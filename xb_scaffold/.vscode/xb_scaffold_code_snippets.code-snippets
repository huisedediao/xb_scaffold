			"    return $1VM(context: context);",
			"  }",
			"",
			"  @override",
			"  Widget buildPage(BuildContext context) {",
			"    final vm = vmOf(context);",
			"    return Container();",
			"  }",
			"}",
			"",
			"class $1VM extends XBPageVM<$1> {",
			"  $1VM({required super.context});",
			"}"
		],
